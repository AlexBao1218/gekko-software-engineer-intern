# Copy to .env; keep .env out of Git. Paths are inside the API container.
NGINX_PORT=8080
DATABASE_PATH=/data/app.db
BACKUP_DIR=/backups
BACKUP_TIMEOUT_SECONDS=30
SEED_CSV_PATH=/srv/data/account_applications.csv

OCR_URL=http://mock_ocr:9100/ocr/parse
OCR_TIMEOUT_SECONDS=1
OCR_MAX_ATTEMPTS=6
OCR_BACKOFF_SECONDS=0.1
OCR_BACKOFF_CAP_SECONDS=0.5
DELIVERY_URL=http://mock_onboarding:9200/ingest
DELIVERY_TIMEOUT_SECONDS=1
DELIVERY_MAX_ATTEMPTS=4
DELIVERY_BACKOFF_SECONDS=0.1
DELIVERY_BACKOFF_CAP_SECONDS=0.5

# Supplied mock fault defaults; override only for a recorded experiment.
OCR_FAIL_RATE=0.2
OCR_HANG_RATE=0.1
OCR_HANG_SECONDS=600
OCR_SEED=42
ONBOARDING_FAIL_RATE=0.2
ONBOARDING_LOST_RATE=0.15
ONBOARDING_LOST_SECONDS=120
ONBOARDING_SEED=7
